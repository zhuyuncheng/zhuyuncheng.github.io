flowchart TD
    A["问题 Q\n例如：解一道高中数学题"]
    A --> B["策略模型 π_θ\n并行采样 G=8 个候选答案"]

    B --> C1["答案 1\n过程 + 结论"]
    B --> C2["答案 2\n过程 + 结论"]
    B --> C3["答案 3\n..."]
    B --> C4["答案 G=8\n过程 + 结论"]

    C1 --> D["规则奖励函数\n✅ 答案正确 +1\n✅ 格式规范 +0.2\n❌ 答案错误 -1"]
    C2 --> D
    C3 --> D
    C4 --> D

    D --> E["组内归一化\nAdvantage_i = (r_i - mean) / std"]
    E --> F["梯度更新\n直接优化策略模型权重"]
    F -.->|"下一轮迭代"| A

    G["⚠️ 传统 PPO/RLHF\n需要额外的 Critic Model\n训练成本 ×2"]
    G -. "GRPO 消除了这一依赖" .-> F

    style G fill:#4a1942,color:#f0e6ef
    style F fill:#1a4a2e,color:#e6f0ea
